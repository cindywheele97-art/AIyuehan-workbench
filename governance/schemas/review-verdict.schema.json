{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiyuehan-workbench:schema:review-verdict:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict_id",
    "round",
    "gate_run_manifest_digest",
    "governing_definition_digest",
    "candidate_sha",
    "evidence_set_digest",
    "reviewer_actor_binding_digest",
    "disposition",
    "standards_basis",
    "spec_basis",
    "findings",
    "issued_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "aiyuehan-workbench.review-verdict/v1"
    },
    "verdict_id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "gate_run_manifest_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "governing_definition_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "candidate_sha": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/git_sha1"
    },
    "evidence_set_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "reviewer_actor_binding_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "disposition": {
      "enum": [
        "PASS",
        "REWORK",
        "BLOCKED"
      ]
    },
    "standards_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
      }
    },
    "spec_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "basis",
          "retest"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "retest": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "issued_at": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339"
    },
    "signature": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/signature"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "PASS"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
