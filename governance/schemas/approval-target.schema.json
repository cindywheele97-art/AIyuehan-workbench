{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiyuehan-workbench:schema:external-governance-approval-target:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "target_id", "action", "repository_id", "proposal_commit_sha",
    "proposal_tree_sha", "payload_manifest_digest", "payload_manifest_raw_sha256",
    "trust_policy_digest", "risk_policy_digest", "bootstrap_envelope_policy_digest",
    "proposed_gate_definition_digest", "governing_gate_content_digest", "gate_assets_digest",
    "remote_precondition_evidence_digest", "intended_protected_ref", "authorized_scope",
    "excluded_scope", "ceremony_nonce", "created_at", "expires_at", "publication_deadline",
    "activation_sequence", "supersedes_activation_digest", "preparer_actor_binding_digest"
  ],
  "properties": {
    "schema_version": { "const": "aiyuehan-workbench.external-governance-approval-target/v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "action": { "const": "authorize_governing_gate_publication" },
    "repository_id": { "type": "string", "minLength": 1 },
    "proposal_commit_sha": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/git_sha1" },
    "proposal_tree_sha": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/git_sha1" },
    "payload_manifest_digest": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256" },
    "payload_manifest_raw_sha256": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256" },
    "trust_policy_digest": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256" },
    "risk_policy_digest": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256" },
    "bootstrap_envelope_policy_digest": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256" },
    "proposed_gate_definition_digest": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256" },
    "governing_gate_content_digest": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256" },
    "gate_assets_digest": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256" },
    "remote_precondition_evidence_digest": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256" },
    "intended_protected_ref": { "const": "refs/tags/governance/r0" },
    "authorized_scope": {
      "const": [
        "authorize only the exact GOV-0/R0 governing content policies and gate assets bound by this target",
        "publish only refs/tags/governance/r0 at the exact proposal root commit bound by this target"
      ]
    },
    "excluded_scope": {
      "const": [
        "M-1 execution",
        "M0 execution",
        "product implementation or product skeleton",
        "External Work Platform installation authentication dynamic qualification or resource mutation",
        "deployment publication release or execution automation other than the one bound governing tag publication",
        "any repository commit tree ref or tag not exactly bound by this target"
      ]
    },
    "ceremony_nonce": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/ceremony_nonce" },
    "created_at": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339" },
    "expires_at": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339" },
    "publication_deadline": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339" },
    "activation_sequence": { "const": 0 },
    "supersedes_activation_digest": { "const": null },
    "preparer_actor_binding_digest": { "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256" }
  }
}
