{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiyuehan-workbench:schema:ref-protection-intent:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "repository",
    "repository_numeric_id",
    "visibility",
    "status",
    "observed_at",
    "enforcement_required",
    "rulesets",
    "credential_boundary",
    "required_readback",
    "required_future_probe",
    "residual_blockers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "aiyuehan-workbench.ref-protection-intent/v1"
    },
    "repository": {
      "const": "cindywheele97-art/AIyuehan-workbench"
    },
    "repository_numeric_id": {
      "const": 1350747678
    },
    "visibility": {
      "const": "public"
    },
    "status": {
      "const": "ACTIVE_ADMIN_READBACK_ONLY"
    },
    "observed_at": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339"
    },
    "enforcement_required": {
      "const": "active"
    },
    "rulesets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/branch_ruleset"
        },
        {
          "$ref": "#/$defs/tag_ruleset"
        }
      ],
      "items": false
    },
    "credential_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_readback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_future_probe": {
      "type": "string",
      "minLength": 1
    },
    "residual_blockers": {
      "const": [
        "signed stable-publisher ruleset-admin evidence is absent",
        "signed pull-only independent attestor precondition is absent",
        "real non-bypass denied-write probe is absent",
        "exact-digest approval and governing activation chain are absent"
      ]
    }
  },
  "$defs": {
    "branch_ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleset_id",
        "name",
        "target",
        "source_type",
        "source",
        "enforcement",
        "include_refs",
        "exclude_refs",
        "rules",
        "pull_request_parameters",
        "bypass_policy",
        "bypass_actors"
      ],
      "properties": {
        "ruleset_id": {
          "const": 21811138
        },
        "name": {
          "const": "governance-main-branch"
        },
        "target": {
          "const": "branch"
        },
        "source_type": {
          "const": "Repository"
        },
        "source": {
          "const": "cindywheele97-art/AIyuehan-workbench"
        },
        "enforcement": {
          "const": "active"
        },
        "include_refs": {
          "const": [
            "refs/heads/main",
            "refs/heads/governance/r0-proposal"
          ]
        },
        "exclude_refs": {
          "const": []
        },
        "rules": {
          "const": [
            "creation",
            "update",
            "deletion",
            "non_fast_forward",
            "pull_request"
          ]
        },
        "pull_request_parameters": {
          "$ref": "#/$defs/pull_request_parameters"
        },
        "bypass_policy": {
          "const": "stable_authority_only_never_candidate_roles"
        },
        "bypass_actors": {
          "const": [
            {
              "actor_id": 284274547,
              "actor_type": "User",
              "bypass_mode": "always"
            }
          ]
        }
      }
    },
    "tag_ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleset_id",
        "name",
        "target",
        "source_type",
        "source",
        "enforcement",
        "include_refs",
        "exclude_refs",
        "rules",
        "bypass_policy",
        "bypass_actors"
      ],
      "properties": {
        "ruleset_id": {
          "const": 21811141
        },
        "name": {
          "const": "governance-r0-tags"
        },
        "target": {
          "const": "tag"
        },
        "source_type": {
          "const": "Repository"
        },
        "source": {
          "const": "cindywheele97-art/AIyuehan-workbench"
        },
        "enforcement": {
          "const": "active"
        },
        "include_refs": {
          "const": [
            "refs/tags/gov0-r0-proposal-v4",
            "refs/tags/governance/r0"
          ]
        },
        "exclude_refs": {
          "const": []
        },
        "rules": {
          "const": [
            "creation",
            "update",
            "deletion"
          ]
        },
        "bypass_policy": {
          "const": "stable_authority_only_never_candidate_roles"
        },
        "bypass_actors": {
          "const": [
            {
              "actor_id": 284274547,
              "actor_type": "User",
              "bypass_mode": "always"
            }
          ]
        }
      }
    },
    "pull_request_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_merge_methods",
        "dismiss_stale_reviews_on_push",
        "require_code_owner_review",
        "require_extra_approval_for_unattributed_changes",
        "require_last_push_approval",
        "required_approving_review_count",
        "required_review_thread_resolution",
        "required_reviewers"
      ],
      "properties": {
        "allowed_merge_methods": {
          "const": [
            "merge",
            "squash",
            "rebase"
          ]
        },
        "dismiss_stale_reviews_on_push": {
          "const": true
        },
        "require_code_owner_review": {
          "const": true
        },
        "require_extra_approval_for_unattributed_changes": {
          "const": true
        },
        "require_last_push_approval": {
          "const": true
        },
        "required_approving_review_count": {
          "const": 1
        },
        "required_review_thread_resolution": {
          "const": true
        },
        "required_reviewers": {
          "const": []
        }
      }
    }
  }
}
