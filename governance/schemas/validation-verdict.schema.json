{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiyuehan-workbench:schema:validation-verdict:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict_id",
    "gate_run_manifest_digest",
    "governing_definition_digest",
    "candidate_sha",
    "evidence_set_digest",
    "review_verdict_digest",
    "validator_actor_binding_digest",
    "nonce",
    "disposition",
    "failure_class",
    "command_results",
    "issued_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "aiyuehan-workbench.validation-verdict/v1"
    },
    "verdict_id": {
      "type": "string",
      "minLength": 1
    },
    "gate_run_manifest_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "governing_definition_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "candidate_sha": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/git_sha1"
    },
    "evidence_set_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "review_verdict_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "validator_actor_binding_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "nonce": {
      "type": "string",
      "minLength": 16
    },
    "disposition": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "failure_class": {
      "enum": [
        "product",
        "evidence",
        "process",
        "interrupted",
        "unknown",
        "none"
      ]
    },
    "command_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "evidence_digest",
          "outcome"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_digest": {
            "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
          },
          "outcome": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "INTERRUPTED"
            ]
          }
        }
      }
    },
    "issued_at": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339"
    },
    "signature": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/signature"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "PASS"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "failure_class": {
            "const": "none"
          },
          "command_results": {
            "items": {
              "properties": {
                "outcome": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "failure_class": {
            "not": {
              "const": "none"
            }
          }
        }
      }
    }
  ]
}
