{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiyuehan-workbench:schema:bootstrap-development-envelope:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "repository_id",
    "subject_digest",
    "beneficiary",
    "policy_digest",
    "trust_policy_digest",
    "allowed_commands",
    "write_paths",
    "network_allowlist",
    "isolation_profile_digest",
    "credential_class",
    "audit_location",
    "nonce",
    "issued_at",
    "expires_at",
    "issuer_actor_binding_digest",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "aiyuehan-workbench.bootstrap-development-envelope/v1"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "beneficiary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "session_id",
        "role"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "builder",
            "reviewer",
            "validator",
            "conductor",
            "approver"
          ]
        }
      }
    },
    "policy_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "trust_policy_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "allowed_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "write_paths": {
      "type": "array",
      "items": {
        "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/repo_path"
      }
    },
    "network_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "isolation_profile_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "credential_class": {
      "enum": [
        "none",
        "synthetic",
        "governance_read_only",
        "governance_authority"
      ]
    },
    "audit_location": {
      "type": "string",
      "minLength": 1
    },
    "nonce": {
      "type": "string",
      "minLength": 16
    },
    "issued_at": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339"
    },
    "expires_at": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339"
    },
    "issuer_actor_binding_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "signature": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/signature"
    }
  }
}
