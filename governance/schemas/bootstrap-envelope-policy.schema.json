{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiyuehan-workbench:schema:bootstrap-envelope-policy:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "policy_id",
    "revision",
    "status",
    "effective",
    "trust_policy_digest",
    "allowed_milestones",
    "eligible_roles",
    "command_policy",
    "filesystem_policy",
    "network_policy",
    "credential_policy",
    "isolation_policy",
    "audit_policy",
    "lifetime_policy",
    "replay_policy",
    "forbidden_effects",
    "activation_requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "aiyuehan-workbench.bootstrap-envelope-policy/v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "REVOKED"
      ]
    },
    "effective": {
      "type": "boolean"
    },
    "trust_policy_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "allowed_milestones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "M-1",
          "M0",
          "M0-Q",
          "M1",
          "M1-Q",
          "M2",
          "M3",
          "M4"
        ]
      }
    },
    "eligible_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "builder",
          "reviewer",
          "validator",
          "conductor",
          "approver"
        ]
      }
    },
    "command_policy": {
      "$ref": "#/$defs/policy_block"
    },
    "filesystem_policy": {
      "$ref": "#/$defs/policy_block"
    },
    "network_policy": {
      "$ref": "#/$defs/policy_block"
    },
    "credential_policy": {
      "$ref": "#/$defs/policy_block"
    },
    "isolation_policy": {
      "$ref": "#/$defs/policy_block"
    },
    "audit_policy": {
      "$ref": "#/$defs/policy_block"
    },
    "lifetime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_ttl_seconds",
        "expiry_required"
      ],
      "properties": {
        "max_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "expiry_required": {
          "const": true
        }
      }
    },
    "replay_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonce_required",
        "single_use"
      ],
      "properties": {
        "nonce_required": {
          "const": true
        },
        "single_use": {
          "const": true
        }
      }
    },
    "forbidden_effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activation_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issuer_actor_binding_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "activated_at": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339"
    },
    "signature": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/signature"
    },
    "revoked_at": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339"
    }
  },
  "$defs": {
    "policy_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "requirements"
      ],
      "properties": {
        "mode": {
          "enum": [
            "deny_by_default",
            "exact_allowlist"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PROPOSED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "effective": {
            "const": false
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "issuer_actor_binding_digest"
              ]
            },
            {
              "required": [
                "signature"
              ]
            },
            {
              "required": [
                "activated_at"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "issuer_actor_binding_digest",
          "activated_at",
          "signature"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACTIVE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "activated_at"
        ],
        "properties": {
          "effective": {
            "const": true
          }
        },
        "not": {
          "required": [
            "revoked_at"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REVOKED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "activated_at",
          "revoked_at"
        ],
        "properties": {
          "effective": {
            "const": false
          }
        }
      }
    }
  ]
}
