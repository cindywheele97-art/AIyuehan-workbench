{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiyuehan-workbench:schema:external-development-risk-policy:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "policy_id",
    "revision",
    "status",
    "effective",
    "trust_policy_digest",
    "scope",
    "risk_classes",
    "mandatory_invariants",
    "failure_policy",
    "activation_requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "aiyuehan-workbench.external-development-risk-policy/v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "REVOKED"
      ]
    },
    "effective": {
      "type": "boolean"
    },
    "trust_policy_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "scope": {
      "const": "GOV-0 development governance through M4"
    },
    "risk_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "external_effects",
          "minimum_assurance"
        ],
        "properties": {
          "id": {
            "enum": [
              "governance_static",
              "upstream_static",
              "product_build",
              "dynamic_qualification",
              "release"
            ]
          },
          "external_effects": {
            "enum": [
              "none",
              "read_only",
              "managed_grant_required",
              "forbidden"
            ]
          },
          "minimum_assurance": {
            "enum": [
              "mechanical",
              "reviewed",
              "validated",
              "approved"
            ]
          }
        }
      }
    },
    "mandatory_invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing",
        "skip",
        "error",
        "interrupted",
        "unknown"
      ],
      "properties": {
        "missing": {
          "const": "BLOCKED"
        },
        "skip": {
          "const": "BLOCKED"
        },
        "error": {
          "const": "BLOCKED"
        },
        "interrupted": {
          "const": "BLOCKED"
        },
        "unknown": {
          "const": "BLOCKED"
        }
      }
    },
    "activation_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issuer_actor_binding_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "activated_at": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339"
    },
    "signature": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/signature"
    },
    "revoked_at": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PROPOSED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "effective": {
            "const": false
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "issuer_actor_binding_digest"
              ]
            },
            {
              "required": [
                "signature"
              ]
            },
            {
              "required": [
                "activated_at"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "issuer_actor_binding_digest",
          "activated_at",
          "signature"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACTIVE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "activated_at"
        ],
        "properties": {
          "effective": {
            "const": true
          }
        },
        "not": {
          "required": [
            "revoked_at"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REVOKED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "activated_at",
          "revoked_at"
        ],
        "properties": {
          "effective": {
            "const": false
          }
        }
      }
    }
  ]
}
