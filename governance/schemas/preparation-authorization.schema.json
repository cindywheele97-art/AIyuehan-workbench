{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiyuehan-workbench:schema:preparation-authorization:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "authorization_id",
    "recorded_at",
    "authority_source",
    "resolved_repository",
    "allowed_effects",
    "forbidden_effects",
    "formal_approval",
    "effective_governing_definition",
    "remote_action_state"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "aiyuehan-workbench.preparation-authorization/v1"
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/rfc3339"
    },
    "authority_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "received_date",
        "instruction"
      ],
      "properties": {
        "kind": {
          "const": "authenticated_user_message"
        },
        "received_date": {
          "type": "string",
          "format": "date"
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resolved_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "owner_database_id",
        "owner_type",
        "name",
        "visibility",
        "resolution_basis",
        "remote_exists_at_recording"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "owner_database_id": {
          "type": "integer",
          "minimum": 1
        },
        "owner_type": {
          "enum": [
            "User",
            "Organization"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "const": "private"
        },
        "resolution_basis": {
          "type": "string",
          "minLength": 1
        },
        "remote_exists_at_recording": {
          "type": "boolean"
        }
      }
    },
    "allowed_effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "formal_approval": {
      "const": false
    },
    "effective_governing_definition": {
      "const": false
    },
    "remote_action_state": {
      "enum": [
        "NOT_REQUESTED",
        "READY",
        "BLOCKED_PROTECTION_ENTITLEMENT",
        "COMPLETE"
      ]
    }
  }
}
