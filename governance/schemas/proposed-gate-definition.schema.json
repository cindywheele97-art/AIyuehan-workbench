{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiyuehan-workbench:schema:proposed-gate-definition:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "definition_id",
    "revision",
    "status",
    "effective",
    "milestone",
    "execution_class",
    "provider_credentials",
    "risk_policy_digest",
    "trust_policy_digest",
    "bootstrap_envelope_policy_digest",
    "gate_assets",
    "runner",
    "commands",
    "evidence_requirements",
    "skip_policy",
    "clean_tree_required",
    "dynamic_external_effects_allowed",
    "allowed_effects",
    "forbidden_effects",
    "required_outputs",
    "forbidden_claims",
    "activation_requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "aiyuehan-workbench.proposed-gate-definition/v1"
    },
    "definition_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "PROPOSED"
    },
    "effective": {
      "const": false
    },
    "milestone": {
      "enum": [
        "GOV-0/R0",
        "M-1",
        "M0",
        "M0-Q",
        "M1",
        "M1-Q",
        "M2",
        "M3",
        "M4"
      ]
    },
    "execution_class": {
      "enum": [
        "governance_static_validation",
        "static_assessment",
        "controlled_build",
        "dynamic_qualification"
      ]
    },
    "provider_credentials": {
      "enum": [
        "none",
        "synthetic",
        "managed_attempt_scoped"
      ]
    },
    "risk_policy_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "trust_policy_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "bootstrap_envelope_policy_digest": {
      "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
    },
    "gate_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/repo_path"
          },
          "sha256": {
            "$ref": "urn:aiyuehan-workbench:schema:common:v1#/$defs/sha256"
          }
        }
      }
    },
    "runner": {
      "$ref": "#/$defs/runner"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skip_policy": {
      "const": "fail"
    },
    "clean_tree_required": {
      "const": true
    },
    "dynamic_external_effects_allowed": {
      "type": "boolean"
    },
    "allowed_effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activation_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "toolchain",
        "network",
        "governance_preconditions"
      ],
      "properties": {
        "kind": {
          "const": "local_external_governance_runner"
        },
        "toolchain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "network": {
          "enum": [
            "denied",
            "read_only_allowlist"
          ]
        },
        "governance_preconditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "timeout_seconds",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "const": "."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "required": {
          "const": true
        }
      }
    }
  }
}
