  "runner": {
    "kind": "local_external_governance_runner",
    "toolchain": [
      {
        "name": "bash",
        "path": "/bin/bash",
        "version": "3.2.57(1)-release"
      },
      {
        "name": "git",
        "path": "/usr/bin/git",
        "version": "2.39.5 (Apple Git-154)"
      },
      {
        "name": "jq",
        "path": "/usr/bin/jq",
        "version": "1.7.1-apple"
      },
      {
        "name": "node",
        "path": "/opt/homebrew/bin/node",
        "version": "26.7.0"
      },
      {
        "name": "shasum",
        "path": "/usr/bin/shasum",
        "version": "6.02"
      }
    ],
    "network": "denied",
    "governance_preconditions": [
      "namespace and public-continuation authorization canonical digests match their user instructions",
      "proposal payload manifest is closed-world and pending formal approval",
      "no active trust policy Approval Record or Governing Gate Definition is claimed"
    ]
  },
  "commands": [
    {
      "id": "verify-r0-sealed",
      "argv": [
        "/usr/bin/env",
        "-i",
        "PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin",
        "LC_ALL=C",
        "GIT_CONFIG_GLOBAL=/dev/null",
        "GIT_CONFIG_SYSTEM=/dev/null",
        "/bin/bash",
        "--noprofile",
        "--norc",
        "governance/tools/verify-r0.sh",
        "sealed"
      ],
      "cwd": ".",
      "timeout_seconds": 120,
      "required": true
    }
  ],
  "evidence_requirements": [
    "raw command output and exit status",
    "closed-world payload path and digest verification",
    "content-addressed BUILD-LOG historical evidence resolution without rewriting prior events",
    "single root commit and clean tree verification after sealing",
    "independent Spec and Standards review of the fixed root commit",
    "unsigned administrator readback retained without upgrading it to signed publisher or pull-only attestor evidence"
  ],
  "skip_policy": "fail",
  "clean_tree_required": true,
  "dynamic_external_effects_allowed": false,
  "allowed_effects": [
    "read governance and architecture files",
    "parse JSON and canonicalize governance records",
    "compute local file and Git object digests",
    "write raw local governance evidence outside the governed payload"
  ],
  "forbidden_effects": [
    "M-1 or M0 execution",
    "product code or product skeleton creation",
    "installation authentication or provider credential use",
    "External Work Platform or customer resource mutation",
    "deploy publish release or execution automation",
    "remote creation or push without active branch and tag protection capability"
  ],
  "required_outputs": [
    "R0ProposalMechanicalEvidence",
    "R0PayloadManifestDigest",
    "R0IndependentReviewVerdict",
    "R0RemoteProtectionDisposition"
  ],
  "forbidden_claims": [
    "FormalApproval",
    "ActiveTrustPolicy",
    "GoverningGateDefinition",
    "ProtectedRemote",
    "M-1Started",
    "M0Started"
  ],
  "activation_requirements": [
    "the closed-keyword Draft 2020-12 schema profile validates every instantiated record and rejects unsupported schema keywords",
    "an active trust policy is signed by a real root key whose SPKI SHA-256 is supplied to the verifier out of band",
    "stable-authority publisher Definition Issuer Approver and read-only remote attestor use different principals sessions and public key material",
    "publisher-signed precondition admin evidence binds repository ID 1350747678 exact ruleset IDs and names root commit tree source include empty-exclude rule sets complete branch pull-request parameters tag parameter absence sole stable publisher bypass raw capture and absence of refs/tags/governance/r0",
    "pull-only attestor signed precondition binds the publisher-admin digest and independently confirms the same fixed repository identity refs ruleset IDs names and all public rule parameters without claiming hidden bypass visibility",
    "exact Approval Target and signed Approval Record bind the complete proposal policy content asset nonce expiry and precondition digests",
    "Definition Issuer signs an ineffective AUTHORIZED_PENDING_PUBLICATION activation authorization",
    "annotated refs/tags/governance/r0 exact tagger identity and message bind the stable publisher repository nonce proposal manifest Approval and activation digests",
    "publisher-signed post-publication admin evidence binds unchanged complete rulesets exact governing tag and admin raw capture",
    "pull-only attestor signed post-publication readback binds the publisher-admin digest exact governing tag object peeled commit tree message public rules and independent raw capture",
    "an isolated external runner materializes every schema canonicalizer validator and activation verifier from the exact approved Git commit before execution",
    "the composite verifier derives GOVERNING_GATE_ACTIVE only from the complete chain outside Candidate write authority"
  ]
}
